# Where the browser finds the backend API (no trailing slash).
# - Local development: http://localhost:8000
# - Behind one domain with a reverse proxy that forwards /api to the backend: leave it empty.
# This value is baked into the page at build time (NEXT_PUBLIC_*), so rebuild after changing it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# How the browser reaches the backend:
#   direct -> calls NEXT_PUBLIC_API_BASE_URL (e.g. http://localhost:8000)
#   nginx  -> calls the page's own address; nginx forwards /api, /health, /ready, /docs to the backend (deploy/nginx)
# Restart `npm run dev` (or rebuild) after changing it.
NEXT_PUBLIC_API_TARGET=direct
