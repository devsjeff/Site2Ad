# Docker (docker compose --profile nginx up). The nginx image fills in ${ADSIFY_BACKEND} / ${ADSIFY_FRONTEND} at start.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream adsify_backend  { server ${ADSIFY_BACKEND}; }
upstream adsify_frontend { server ${ADSIFY_FRONTEND}; }

server {
    listen 80;
    server_name _;
    include /etc/nginx/adsify-locations.conf;
}
