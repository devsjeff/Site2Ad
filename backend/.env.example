# Copy this file to `.env` (same folder) and edit the values you need. Every value shown is the default.
# NEVER commit your real `.env`, and never put real keys in this example file.

# ---------------------------------------------------------------- app
# development | production (production hides /docs)
APP_ENV=development
LOG_LEVEL=INFO
# videos, uploads and the SQLite file live here
DATA_DIR=./data
# this build supports SQLite only
DATABASE_URL=sqlite:///./data/adsify.db
# optional, e.g. redis://localhost:6379/0 (scan cache; memory cache is used when empty)
REDIS_URL=
# comma separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# true only behind a reverse proxy you control (uses X-Forwarded-For for rate limits)
TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------- video (leave the key empty for demo mode)
# Magic Hour API key. Empty = demo mode (free ffmpeg zoom clips)
VIDEO_MODEL_API_KEY=
# auto | magic_hour | mock   (auto = magic_hour when a key is set)
VIDEO_PROVIDER=auto
MAGIC_HOUR_MODEL=ltx-2.5
VIDEO_RESOLUTION=480p
# longest clip the video model makes
VIDEO_MAX_SECONDS=5
VIDEO_TIMEOUT_SECONDS=600
# make a demo-quality clip when the video model fails
VIDEO_FALLBACK_ON_ERROR=true
# smaller images get a "may look soft" warning
HERO_MIN_SIDE_PX=400
# optional .ttf for the text on the video (needed for some non-Latin scripts)
OVERLAY_FONT_PATH=
# size of ads built with FFmpeg only (manual uploads and website-image ads); AI clips use VIDEO_RESOLUTION
COMPOSE_RESOLUTION=720p
# longest prompt sent to the video model (Magic Hour accepts at most 2000 characters)
VIDEO_PROMPT_MAX_CHARS=2000

# ---------------------------------------------------------------- AI prompt writer (optional)
# OpenRouter / OpenAI compatible key. Empty = built-in prompt writer
AI_PROMPT_API_KEY=
AI_PROMPT_BASE_URL=https://openrouter.ai/api/v1
AI_PROMPT_MODEL=openrouter/free
AI_PROMPT_TIMEOUT_SECONDS=40

# ---------------------------------------------------------------- website scanner
# total budget for one scan (both phases)
MAX_SCRAPE_SECONDS=60
MAX_PHASE1_SECONDS=12                   # homepage-only first phase (target 5 s)
# 5 MB per page
MAX_RESPONSE_BYTES=5242880
MAX_REDIRECTS=5
REQUEST_TIMEOUT_SECONDS=8
MAX_IMAGES=8
MIN_IMAGE_PX=50
# inner pages read in phase 2
MAX_CRAWL_PAGES=8
CRAWL_CONCURRENCY=4
PHASE2_MODE=always                      # always | auto | never
SCRAPE_CACHE_TTL_HOURS=24
BLOCKED_CACHE_TTL_MINUTES=60
RESPECT_ROBOTS=true
BOT_NAME=AdsifyBot
USER_AGENT=Mozilla/5.0 (compatible; AdsifyBot/1.0)

# ---------------------------------------------------------------- headless browser (only used for JavaScript sites)
# firefox (default) | chromium | webkit
PLAYWRIGHT_BROWSER=firefox
PLAYWRIGHT_HEADLESS=true
MAX_CONCURRENT_RENDERS=3
BROWSER_RECYCLE_JOBS=100
RENDER_TIMEOUT_SECONDS=12

# ---------------------------------------------------------------- limits and cleanup
MAX_CONCURRENT_SCRAPES=4
# videos created at the same time
MAX_CONCURRENT_ADS=2
# per client, for scan / upload / create-ad requests
RATE_LIMIT_PER_MINUTE=20
# hard cap on ads per 24 h (protects your video credits)
MAX_ADS_PER_DAY=100
# finished jobs, ads, uploads and videos are deleted after this
DATA_RETENTION_HOURS=72
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_FILES=10
# uploaded videos (manual ads): 50 MB and 60 seconds at most
MAX_VIDEO_UPLOAD_BYTES=52428800
MAX_VIDEO_UPLOAD_SECONDS=60

# ---------------------------------------------------------------- tests only
# NEVER enable: it lets the scanner reach private/internal addresses
# UNSAFE_ALLOW_PRIVATE_NETWORKS=false
